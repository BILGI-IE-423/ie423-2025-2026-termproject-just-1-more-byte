# Large data files
data/raw/
# data/processed/ is tracked (mbti_cleaned.csv)

# Docs content (folder tracked via .gitkeep)
docs/*.md
docs/*.pdf
docs/*.docx

# Legacy output folder (use visuals/ instead)
outputs/

# Saved model artifacts (regenerated by pipeline)
models/*.joblib
data/processed/splits/
data/processed/X_train.npz
data/processed/X_test.npz

# Python cache
__pycache__/
*.pyc
*.pyo
.env
